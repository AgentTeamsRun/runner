{
  "name": "@agentteams/runner",
  "version": "0.0.112",
  "description": "AgentRunner - Background runner that polls and executes AI agent tasks",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentrunner": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "native/bin/**/*",
    "readme.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "build:native:win": "powershell -NoProfile -ExecutionPolicy Bypass -File native/win/build.ps1",
    "test:native:win": "powershell -NoProfile -ExecutionPolicy Bypass -File native/win/smoke.ps1",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:file": "tsx --test",
    "lint": "eslint \"src/**/*.ts\" --cache --cache-location .eslintcache --cache-strategy content",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "init": "node dist/index.js init",
    "verify:native:win": "node native/win/verify-package.mjs .",
    "verify:packed:native:win": "node native/win/verify-packed-package.mjs .",
    "prepublishOnly": "pnpm run build && pnpm run verify:packed:native:win"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentTeamsRun/runner.git"
  },
  "bugs": {
    "url": "https://github.com/AgentTeamsRun/runner/issues"
  },
  "homepage": "https://agentteams.run",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agentteams",
    "runner",
    "ai-agent",
    "automation"
  ],
  "license": "Apache-2.0",
  "dependencies": {},
  "devDependencies": {
    "@agentteams/core-constants": "workspace:*",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
